set_global_assignment -name FAMILY "Stratix 10"
set_global_assignment -name DEVICE 1SX280HU2F50E1VG
set_global_assignment -name TOP_LEVEL_ENTITY psvu_top
set_global_assignment -name VERILOG_FILE psvu_top.v
set_global_assignment -name QSYS_FILE psvu_sys.qsys
set_global_assignment -name SDC_FILE psvu_top.sdc
set_global_assignment -name IP_SEARCH_PATHS "../psvu/psvu.prj/components/psv_update/**/*"
# board settings copied from the lab DE10pro_LED project
set_global_assignment -name USE_PWRMGT_SCL SDM_IO0
set_global_assignment -name USE_PWRMGT_SDA SDM_IO12
set_global_assignment -name VID_OPERATION_MODE "PMBUS MASTER"
set_global_assignment -name PWRMGT_BUS_SPEED_MODE "400 KHZ"
set_global_assignment -name PWRMGT_SLAVE_DEVICE_TYPE OTHER
set_global_assignment -name PWRMGT_SLAVE_DEVICE0_ADDRESS 4F
set_global_assignment -name PWRMGT_SLAVE_DEVICE1_ADDRESS 00
set_global_assignment -name PWRMGT_SLAVE_DEVICE2_ADDRESS 00
set_global_assignment -name PWRMGT_SLAVE_DEVICE3_ADDRESS 00
set_global_assignment -name PWRMGT_SLAVE_DEVICE4_ADDRESS 00
set_global_assignment -name PWRMGT_SLAVE_DEVICE5_ADDRESS 00
set_global_assignment -name PWRMGT_SLAVE_DEVICE6_ADDRESS 00
set_global_assignment -name PWRMGT_SLAVE_DEVICE7_ADDRESS 00
set_global_assignment -name PWRMGT_PAGE_COMMAND_ENABLE ON
set_global_assignment -name PWRMGT_VOLTAGE_OUTPUT_FORMAT "AUTO DISCOVERY"
set_global_assignment -name PWRMGT_TRANSLATED_VOLTAGE_VALUE_UNIT VOLTS
set_global_assignment -name STRATIXV_CONFIGURATION_SCHEME "AVST X8"
set_global_assignment -name USE_CONF_DONE SDM_IO16
set_global_assignment -name DEVICE_INITIALIZATION_CLOCK OSC_CLK_1_125MHZ
set_location_assignment PIN_M24 -to CLK_50_B3I
set_instance_assignment -name IO_STANDARD "1.8 V" -to CLK_50_B3I
set_location_assignment PIN_BF27 -to CPU_RESET_n
set_instance_assignment -name IO_STANDARD "1.8 V" -to CPU_RESET_n
set_location_assignment PIN_B24 -to LED[0]
set_location_assignment PIN_A24 -to LED[1]
set_location_assignment PIN_A25 -to LED[2]
set_location_assignment PIN_A26 -to LED[3]
set_instance_assignment -name IO_STANDARD "1.8 V" -to LED[0]
set_instance_assignment -name IO_STANDARD "1.8 V" -to LED[1]
set_instance_assignment -name IO_STANDARD "1.8 V" -to LED[2]
set_instance_assignment -name IO_STANDARD "1.8 V" -to LED[3]
set_global_assignment -name LAST_QUARTUS_VERSION "21.3.0 Pro Edition"
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_clk_in.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_pll.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_jtag.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_u.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_rr.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_mem.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_omem.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_clk_in_0.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_pll_0.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_jtag_0.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_u_0.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_rr_0.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_mem_0.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_omem_0.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_clk_in_1.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_pll_1.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_jtag_1.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_u_1.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_rr_1.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_mem_1.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_omem_1.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_clk_in_2.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_pll_2.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_jtag_2.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_u_2.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_rr_2.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_mem_2.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_omem_2.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_clk_in_3.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_pll_3.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_jtag_3.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_u_3.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_rr_3.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_mem_3.ip
set_global_assignment -name IP_FILE ip/psvu_sys/psvu_sys_omem_3.ip
